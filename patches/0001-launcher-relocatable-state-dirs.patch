+// Resolve a state path the env files may give relative to the library folder (the app's parent),
+// so a game moved with its folder still finds its state. An absolute value is left alone.
+static void resolve_env_path(const char *var, const char *base) {
+    const char *value = getenv(var);
+    if (!value || !*value || value[0] == '/') return;
+    char resolved[PATH_MAX];
+    snprintf(resolved, sizeof resolved, "%s/%s", base, value);
+    setenv(var, resolved, 1);
+}
+
+// DM_ROMFS_OVERLAY lists the enabled mods' RomFS folders, ':'-separated; resolve each relative
+// entry against the library folder the same way, so mods follow a game moved with its folder.
+static void resolve_env_pathlist(const char *var, const char *base) {
+    const char *value = getenv(var);
+    if (!value || !*value) return;
+    char *copy = strdup(value); if (!copy) return;
+    char resolved[PATH_MAX]; size_t used = 0; int ok = 1;
+    for (char *save = NULL, *tok = strtok_r(copy, ":", &save); tok && ok; tok = strtok_r(NULL, ":", &save)) {
+        if (used >= sizeof resolved - 1) { ok = 0; break; }
+        if (used) resolved[used++] = ':';
+        int n = (*tok == '/') ? snprintf(resolved + used, sizeof resolved - used, "%s", tok)
+                              : snprintf(resolved + used, sizeof resolved - used, "%s/%s", base, tok);
+        if (n < 0 || (size_t)n >= sizeof resolved - used) { ok = 0; break; }
+        used += (size_t)n;
+    }
+    free(copy);
+    if (ok) setenv(var, resolved, 1);
 }
 
