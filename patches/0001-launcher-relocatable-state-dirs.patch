+// The player's own file (sup/env.txt) wins over the bundled one: its DM_SAVE points at the
+// active player's store, and an already-set value must not keep the player's choice out.
+static void env_file_overrides(const char *path) {
+    FILE *f = fopen(path, "r"); if (!f) return;
+    char ln[4096];
+    while (fgets(ln, sizeof ln, f)) {
+        char *s = ln; while (*s == ' ' || *s == '\t') s++;
+        char *e = s + strlen(s); while (e > s && (e[-1] == '\n' || e[-1] == '\r' || e[-1] == ' ' || e[-1] == '\t')) *--e = 0;
+        char *eq = strchr(s, '=');
+        if (*s == '#' || !eq || eq == s) continue;
+        *eq = 0; char *k = s; for (char *t = eq - 1; t > k && (*t == ' ' || *t == '\t'); t--) *t = 0;
+        setenv(k, eq + 1, 1); add_key(&g_file_keys, k); fprintf(stderr, "launcher: env %s=%s (%s)\n", k, eq + 1, path);
+    }
+    fclose(f);
+}
